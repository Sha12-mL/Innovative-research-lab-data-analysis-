import pandas as pd
import json
import re
orders = pd.read_csv("orders.csv")
orders.head()
with open("users.json", "r") as f:
    users = pd.DataFrame(json.load(f))

users.head()with open("restaurants.sql", "r") as f:
    sql_text = f.read()

values = re.findall(r'\((.*?)\)', sql_text)

rows = []
for v in values:
    parts = [p.strip().strip("'") for p in v.split(',')]
    rows.append(parts)

restaurants = pd.DataFrame(
    rows,
    columns=["restaurant_id", "restaurant_name", "cuisine", "rating"]
)

restaurants["restaurant_id"] = restaurants["restaurant_id"].astype(int)
restaurants["rating"] = restaurants["rating"].astype(float)

restaurants.head()
df = orders.merge(users, on="user_id", how="left") \
           .merge(restaurants, on="restaurant_id", how="left")

df.head()df["order_date"] = pd.to_datetime(df["order_date"], dayfirst=True)
df.info()df["membership"].value_counts()
df.groupby("city")["total_amount"].sum().sort_values(ascending=False)df.groupby("cuisine")["total_amount"].mean().sort_values(ascending=False)df.groupby("rating")["total_amount"].sum().sort_values(ascending=False)
df["quarter"] = df["order_date"].dt.to_period("Q")
df.groupby("quarter")["total_amount"].sum()

Conclusion
This project successfully merged transactional, user, and restaurant datasets using left joins to create a single source of truth. The analysis provides clear insights into customer behavior, membership impact, city-wise revenue trends, and cuisine performance.

